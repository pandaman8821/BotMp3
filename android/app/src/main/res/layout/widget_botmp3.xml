<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Fila superior: caratula + textos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_portada"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/widget_portada"
            android:contentDescription="@string/widget_cover"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="BotMp3"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_open_hint"
                android:textColor="#E9D5FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#C4A5F0"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_tiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="0:00"
                    android:textColor="#F0ABFC"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_linea_progreso" />

                <TextView
                    android:id="@+id/widget_duracion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="0:00"
                    android:textColor="#C4A5F0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Fila de botones: a todo el ancho, cuadrados exactos (circulos reales) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_rewind"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_boton_circulo"
            android:contentDescription="@string/widget_rewind_10"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_replay_10" />

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_boton_circulo"
            android:contentDescription="@string/widget_prev"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#F3E8FF" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_play_fondo"
            android:contentDescription="@string/widget_play_pause"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_pause"
            android:tint="#1E1033" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_boton_circulo"
            android:contentDescription="@string/widget_next"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_next"
            android:tint="#F3E8FF" />

        <ImageButton
            android:id="@+id/widget_forward"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_boton_circulo"
            android:contentDescription="@string/widget_forward_10"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_forward_10" />
    </LinearLayout>
</LinearLayout>